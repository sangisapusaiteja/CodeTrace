# Supabase - shared with Code Battle and Interview Handbook (https://supabase.com)
# Never put real values in this file: copy it to .env.local (git-ignored) instead.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT session signing (must match between all apps)
SESSION_SECRET=

# Google OAuth (optional - enables Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
